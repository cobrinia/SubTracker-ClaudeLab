{
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(dotnet ef database update:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations remove:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git reset --hard:*)",
      "Edit(src/SubTracker.DB/Migrations/**)",
      "Read(**/secrets.json)"
    ]
  }
}
