<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    REST API менеджера підписок (ЛР № 3). Повторно використовує доменну модель (SubTracker.Domain)
    і модель EF Core (SubTracker.DB) з ЛР № 2: схема БД, міграції та тестові дані спільні.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML-коментарі потрапляють у документ OpenAPI (summary, param, response). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573;AV0029;AV0030</NoWarn>
    <!-- Ті самі user secrets, що й у SubTracker.Console: один рядок підключення для обох застосунків. -->
    <UserSecretsId>c2cfcb5b-812c-4896-9d4c-92885baf4327</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SubTracker.DB\SubTracker.DB.csproj" />
  </ItemGroup>

  <!-- Інтеграційні тести створюють WebApplicationFactory<Program>. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SubTracker.Api.Tests" />
  </ItemGroup>

</Project>
